@using PersonalGTD.Shared.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@implements IDisposable

@code {
    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += HandleAuthStateChanged;
        CheckCurrentSession();
    }

    private void HandleAuthStateChanged()
    {
        CheckCurrentSession();
    }

    private void CheckCurrentSession()
    {
        var uri = NavigationManager.Uri;
        
        // Si l'utilisateur est connecté et qu'on est sur une URL de callback ou avec un fragment de token
        if (AuthService.CurrentUser != null)
        {
            if (uri.Contains("auth/callback") || uri.Contains("#access_token") || uri.Contains("access_token="))
            {
                // Rediriger vers la racine pour nettoyer l'URL et éviter les boucles
                // On utilise forceLoad: true pour être sûr que le client Supabase et Blazor repartent sur une base propre
                NavigationManager.NavigateTo(NavigationManager.BaseUri, forceLoad: true);
            }
        }
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= HandleAuthStateChanged;
    }
}
