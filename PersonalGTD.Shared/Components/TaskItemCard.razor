@using PersonalGTD.Shared.Models

<div class="task-card @(Task.Status == GtdStatus.Done || Task.Status == GtdStatus.Abandoned ? "completed" : "") @(IsHighlighted ? "highlighted-task" : "")" id="task-@(Task.Id)">
    <div class="task-content">
        <div class="task-title">@Task.Title</div>
        <div class="task-badges">
            @{
                var selectedProj = Projects?.FirstOrDefault(p => p.Id == Task.ProjectId);
                var projStyle = selectedProj != null 
                    ? $"color: #0f172a; background-color: {selectedProj.Color}25; border: 1px solid {selectedProj.Color}66; font-weight: 600;" 
                    : "color: #64748b; background-color: #f1f5f9; border: 1px dashed #cbd5e1;";
                
                var selectedCtx = Contexts?.FirstOrDefault(c => c.Id == Task.ContextId);
                var ctxStyle = selectedCtx != null 
                    ? $"color: #0f172a; background-color: {selectedCtx.Color}25; border: 1px solid {selectedCtx.Color}66; font-weight: 600;" 
                    : "color: #64748b; background-color: #f1f5f9; border: 1px dashed #cbd5e1;";
            }
            
            <select class="badge-select" style="@projStyle" value="@Task.ProjectId" @onchange="ChangeProject">
                <option value="" style="color: #0f172a; background-color: #ffffff;">+ Projet</option>
                @if (Projects != null)
                {
                    @foreach(var p in Projects.Where(p => p.Status != GtdStatus.Done && p.Status != GtdStatus.Abandoned || p.Id == Task.ProjectId))
                    {
                        <option value="@p.Id" style="color: #0f172a; background-color: #ffffff;">@p.Name @(p.Status == GtdStatus.Done ? "(Terminé)" : p.Status == GtdStatus.Abandoned ? "(Abandonné)" : "")</option>
                    }
                }
            </select>

            <select class="badge-select" style="@ctxStyle" value="@Task.ContextId" @onchange="ChangeContext">
                <option value="" style="color: #0f172a; background-color: #ffffff;">+ Contexte</option>
                @if (Contexts != null)
                {
                    @foreach(var c in Contexts)
                    {
                        <option value="@c.Id" style="color: #0f172a; background-color: #ffffff;">@c.Name</option>
                    }
                }
            </select>

            @{
                var dateStyle = Task.DueDate.HasValue 
                    ? (Task.DueDate.Value.Date < DateTime.Now.Date ? "color: #ef4444; background-color: #fee2e2; border: 1px solid #ef4444;"
                        : Task.DueDate.Value.Date == DateTime.Now.Date ? "color: #f97316; background-color: #ffedd5; border: 1px solid #f97316;"
                        : "color: #22c55e; background-color: #dcfce7; border: 1px solid #22c55e;")
                    : "color: #64748b; background-color: #f1f5f9; border: 1px dashed #cbd5e1;";
            }
            <input type="date" 
                   class="badge-select date-badge @(!Task.DueDate.HasValue ? "empty-date" : "")" 
                   style="@dateStyle" 
                   value="@(Task.DueDate?.ToString("yyyy-MM-dd") ?? "")" 
                   @onchange="ChangeDueDate" />
        </div>
    </div>
    
    <div class="task-actions">
        <select class="status-select" value="@Task.Status" @onchange="ChangeStatus">
            <option value="@GtdStatus.Inbox">Inbox</option>
            <option value="@GtdStatus.NextAction">Prochaine Action</option>
            <option value="@GtdStatus.Waiting">En attente</option>
            <option value="@GtdStatus.Sometime">Un jour / Peut-être</option>
            <option value="@GtdStatus.Done">Réalisée</option>
            <option value="@GtdStatus.Abandoned">Abandonnée</option>
        </select>

        <button class="desc-button @(!string.IsNullOrWhiteSpace(Task.Note) ? "has-note" : "")" @onclick="OpenModal" title="Description">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        </button>

        <button class="delete-button" @onclick="DeleteTask" title="Supprimer">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
        </button>
    </div>
</div>

@if (isModalOpen)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>@Task.Title</h3>
                <button class="close-modal-btn" @onclick="CloseModal">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            <div class="modal-body">
                <textarea class="modal-textarea" placeholder="Ajouter une description, des notes, des liens utiles..." @bind="editNote" autofocus></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseModal">Annuler</button>
                <button class="btn-save" @onclick="SaveNote">Enregistrer</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public GtdItem Task { get; set; } = default!;
    [Parameter] public IEnumerable<GtdProject>? Projects { get; set; }
    [Parameter] public IEnumerable<GtdContext>? Contexts { get; set; }
    [Parameter] public bool IsHighlighted { get; set; } = false;
    
    [Parameter] public EventCallback<GtdItem> OnTaskUpdated { get; set; }
    [Parameter] public EventCallback<Guid> OnTaskDeleted { get; set; }

    private async Task ChangeStatus(ChangeEventArgs e)
    {
        if (Enum.TryParse<GtdStatus>(e.Value?.ToString(), out var newStatus))
        {
            Task.Status = newStatus;
            await OnTaskUpdated.InvokeAsync(Task);
        }
    }

    private async Task DeleteTask()
    {
        await OnTaskDeleted.InvokeAsync(Task.Id);
    }
    private async Task ChangeProject(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var newProjectId))
        {
            Task.ProjectId = newProjectId;
        }
        else
        {
            Task.ProjectId = null;
        }
        await OnTaskUpdated.InvokeAsync(Task);
    }

    private async Task ChangeContext(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var newContextId))
        {
            Task.ContextId = newContextId;
        }
        else
        {
            Task.ContextId = null;
        }
        await OnTaskUpdated.InvokeAsync(Task);
    }

    private async Task ChangeDueDate(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var newDate))
        {
            Task.DueDate = DateTime.SpecifyKind(newDate, DateTimeKind.Utc);
        }
        else
        {
            Task.DueDate = null;
        }
        await OnTaskUpdated.InvokeAsync(Task);
    }

    private bool isModalOpen = false;
    private string editNote = string.Empty;

    private void OpenModal()
    {
        editNote = Task.Note ?? string.Empty;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task SaveNote()
    {
        Task.Note = editNote;
        isModalOpen = false;
        await OnTaskUpdated.InvokeAsync(Task);
    }
}
