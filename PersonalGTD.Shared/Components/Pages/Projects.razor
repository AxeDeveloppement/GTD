@page "/projects"
@using PersonalGTD.Shared.Models
@using PersonalGTD.Shared.Services
@inject IProjectService ProjectService
@inject ITaskService TaskService
@inject IContextService ContextService
@inject NavigationManager Navigation

<div class="page-container">
    <div class="page-header">
        <h2 class="title-nowrap">Gestion des Projets</h2>
        <button class="btn-primary" @onclick="ShowAddForm">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Nouveau Projet
        </button>
    </div>

    @if (showForm)
    {
        <div class="form-card">
            <h3>@(editingProject == null ? "Nouveau Projet" : "Modifier le Projet")</h3>
            <div class="form-group">
                <label>Nom du projet</label>
                <input type="text" @bind="projectModel.Name" placeholder="Ex: Finaliser mon site web" />
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea @bind="projectModel.Description" placeholder="Détails du projet..."></textarea>
            </div>
            <div class="form-group">
                <label>Couleur</label>
                <input type="color" @bind="projectModel.Color" />
            </div>
            <div class="form-actions">
                <button class="btn-secondary" @onclick="HideForm">Annuler</button>
                <button class="btn-primary" @onclick="SaveProject">Enregistrer</button>
            </div>
        </div>
    }

    <div class="grid-container">
        @if (projects == null || !projects.Any())
        {
            <div class="empty-state">
                <p>Aucun projet pour le moment. Créez-en un pour organiser vos tâches !</p>
            </div>
        }
        else
        {
            @foreach (var p in projects)
            {
                <div class="card" style="border-top: 4px solid @p.Color">
                    <div class="card-header">
                        <div class="title-zone" title="@p.Name">
                            <h4 class="project-title">
                                <span class="truncated">@TruncateTitle(p.Name)</span>
                                <span class="full">@p.Name</span>
                            </h4>
                        </div>
                        <div class="actions-zone">
                            <button class="icon-btn view-tasks @(expandedProjectId == p.Id ? "active" : "")" @onclick="() => ToggleProjectTasks(p.Id)" title="Voir les tâches">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            </button>
                            <button class="icon-btn done" @onclick="() => SetProjectStatus(p, GtdStatus.Done)" title="Marquer comme réalisé">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </button>
                            <button class="icon-btn abandon" @onclick="() => SetProjectStatus(p, GtdStatus.Abandoned)" title="Abandonner">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                            </button>
                            <button class="icon-btn edit" @onclick="() => EditProject(p)" title="Modifier">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            </button>
                            <button class="icon-btn delete" @onclick="() => DeleteProject(p.Id)" title="Supprimer">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </div>
                    </div>
                    <div class="description-zone">
                        <p class="description">@p.Description</p>
                    </div>

                    @if (expandedProjectId == p.Id)
                    {
                        var projectTasks = GetTasksForProject(p.Id);
                        <div class="tasks-panel">
                            <div class="tasks-panel-header">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                                <span>Tâches liées (@projectTasks.Count)</span>
                            </div>
                            @if (!projectTasks.Any())
                            {
                                <p class="tasks-panel-empty">Aucune tâche liée à ce projet.</p>
                            }
                            else
                            {
                                <ul class="tasks-panel-list">
                                    @foreach (var t in projectTasks)
                                    {
                                        <li class="tasks-panel-item @(t.Status == GtdStatus.Done ? "done" : "")">
                                            <span class="task-status-dot status-@t.Status.ToString().ToLower()"></span>
                                            <span class="task-title">@t.Title</span>
                                            @if (t.ContextId.HasValue)
                                            {
                                                var ctx = contexts?.FirstOrDefault(c => c.Id == t.ContextId.Value);
                                                @if (ctx != null)
                                                {
                                                    <span class="task-context-tag" style="color: @ctx.Color; background: @(ctx.Color)22; border: 1px solid @(ctx.Color)44">@ctx.Name</span>
                                                }
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    private List<GtdProject> projects;
    private List<GtdItem>? allTasks;
    private List<GtdContext>? contexts;
    private bool showForm = false;
    private GtdProject projectModel = new GtdProject { Color = "#4f46e5" };
    private GtdProject editingProject = null;
    private Guid? expandedProjectId = null;

    protected override async Task OnInitializedAsync()
    {
        contexts = await ContextService.GetContextsAsync();
        allTasks = (await TaskService.GetItemsAsync()).ToList();
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        projects = await ProjectService.GetProjectsAsync();
    }

    private List<GtdItem> GetTasksForProject(Guid projectId)
    {
        if (allTasks == null) return new List<GtdItem>();
        return allTasks.Where(t => t.ProjectId == projectId).ToList();
    }

    private async Task ToggleProjectTasks(Guid projectId)
    {
        if (expandedProjectId == projectId)
        {
            expandedProjectId = null;
        }
        else
        {
            // Refresh tasks when opening a panel
            allTasks = (await TaskService.GetItemsAsync()).ToList();
            expandedProjectId = projectId;
        }
    }

    private void ShowAddForm()
    {
        editingProject = null;
        projectModel = new GtdProject { Color = "#4f46e5" };
        showForm = true;
    }

    private void HideForm()
    {
        showForm = false;
        editingProject = null;
    }

    private void EditProject(GtdProject project)
    {
        editingProject = project;
        projectModel = new GtdProject
        {
            Id = project.Id,
            Name = project.Name,
            Description = project.Description,
            Color = project.Color,
            Status = project.Status,
            OwnerUsername = project.OwnerUsername
        };
        showForm = true;
    }

    private async Task SaveProject()
    {
        if (string.IsNullOrWhiteSpace(projectModel.Name)) return;

        if (editingProject == null)
        {
            await ProjectService.AddProjectAsync(projectModel);
        }
        else
        {
            await ProjectService.UpdateProjectAsync(projectModel);
        }

        HideForm();
        await LoadProjects();
    }

    private async Task SetProjectStatus(GtdProject project, GtdStatus status)
    {
        project.Status = status;
        await ProjectService.UpdateProjectAsync(project);
        await LoadProjects();
    }

    private async Task DeleteProject(Guid id)
    {
        await ProjectService.DeleteProjectAsync(id);
        await LoadProjects();
    }

    private string TruncateTitle(string title)
    {
        if (string.IsNullOrEmpty(title)) return title;
        int limit = 20; // Enough to read most, but safe
        if (title.Length <= limit) return title;
        return title.Substring(0, limit) + "...";
    }
}
