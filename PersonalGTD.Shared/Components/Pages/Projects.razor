@page "/projects"
@using PersonalGTD.Shared.Models
@using PersonalGTD.Shared.Services
@inject IProjectService ProjectService
@inject ITaskService TaskService
@inject IContextService ContextService
@inject NavigationManager Navigation

<div class="page-container">

    @if (selectedProject == null)
    {
        <!-- ===== VUE LISTE DES PROJETS ===== -->
        <div class="page-header">
            <h1 class="page-title">Gestion des Projets</h1>
            <p class="page-subtitle">Organisez vos objectifs complexes en projets structurés.</p>
            <div class="page-actions">
                <button class="btn-primary" @onclick="ShowAddForm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    Nouveau Projet
                </button>
            </div>
        </div>

        @if (showForm)
        {
            <div class="form-card">
                <h3>@(editingProject == null ? "Nouveau Projet" : "Modifier le Projet")</h3>
                <div class="form-group">
                    <label>Nom du projet</label>
                    <input type="text" @bind="projectModel.Name" placeholder="Ex: Finaliser mon site web" />
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea @bind="projectModel.Description" placeholder="Détails du projet..."></textarea>
                </div>
                <div class="form-group">
                    <label>Couleur</label>
                    <input type="color" @bind="projectModel.Color" />
                </div>
                <div class="form-actions">
                    <button class="btn-secondary" @onclick="HideForm">Annuler</button>
                    <button class="btn-primary" @onclick="SaveProject">Enregistrer</button>
                </div>
            </div>
        }

        <div class="grid-container">
            @if (projects == null || !projects.Any())
            {
                <div class="empty-state">
                    <p>Aucun projet pour le moment. Créez-en un pour organiser vos tâches !</p>
                </div>
            }
            else
            {
                @foreach (var p in projects)
                {
                    <div class="card" style="--accent-color: @p.Color; border-left: 4px solid var(--accent-color);">
                        <div class="card-top">
                            <svg class="card-title-icon" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" style="color: var(--accent-color);">
                                <defs>
                                    <linearGradient id="pg-@p.Id" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="currentColor" stop-opacity="1" />
                                        <stop offset="100%" stop-color="currentColor" stop-opacity="0.3" />
                                    </linearGradient>
                                </defs>
                                <path d="M12 2L2 7L12 12L22 7L12 2Z" fill="url(#pg-@p.Id)" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                                <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M12 22V12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5" />
                            </svg>
                            <h4 class="project-title">@p.Name</h4>
                        </div>

                        <!-- Description -->
                        @if (!string.IsNullOrWhiteSpace(p.Description))
                        {
                            <p class="description">@p.Description</p>
                        }

                        <!-- Séparateur + Actions -->
                        <div class="card-footer">
                            <button class="btn-view-tasks" @onclick="() => OpenProjectView(p)" title="Voir les tâches liées">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            </button>
                            <div class="card-actions">
                                <button class="icon-btn done" @onclick="() => SetProjectStatus(p, GtdStatus.Done)" title="Marquer comme réalisé">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                </button>
                                <button class="icon-btn abandon" @onclick="() => SetProjectStatus(p, GtdStatus.Abandoned)" title="Abandonner">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                </button>
                                <button class="icon-btn edit" @onclick="() => EditProject(p)" title="Modifier">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </button>
                                <button class="icon-btn delete" @onclick="() => DeleteProject(p.Id)" title="Supprimer">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <!-- ===== VUE DÉTAIL PROJET : TÂCHES LIÉES ===== -->
        <div class="project-detail-view">
            <div class="detail-header" style="background: linear-gradient(135deg, @selectedProject.Color 0%, #0f172a 100%);">
                <button class="btn-back" @onclick="CloseProjectView">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    Retour aux projets
                </button>
                <div class="detail-title-block">
                    <h2 class="detail-project-name">@selectedProject.Name</h2>
                </div>
                @if (!string.IsNullOrWhiteSpace(selectedProject.Description))
                {
                    <p class="detail-description">@selectedProject.Description</p>
                }
            </div>

            <div class="detail-tasks-section">
                <div class="detail-tasks-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" style="color: var(--accent-color);">
                        <path opacity="0.25" d="M12 3L2 8L12 13L22 8L12 3Z" fill="currentColor" />
                        <path d="M12 3L2 8L12 13L22 8L12 3Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M2 13L12 18L22 13" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M2 18L12 23L22 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>Actions identifiées <span class="task-count-badge">@projectTasks.Count</span></span>
                </div>

                @if (!projectTasks.Any())
                {
                    <div class="detail-empty">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                        <p>Aucune tâche associée à ce projet.</p>
                        <span>Ajoutez des tâches depuis l'Inbox ou les Prochaines Actions.</span>
                    </div>
                }
                else
                {
                    <div class="task-list">
                        @foreach (var task in projectTasks)
                        {
                            <TaskItemCard Task="task"
                                         Projects="projects"
                                         Contexts="contexts"
                                         OnTaskUpdated="HandleTaskUpdated"
                                         OnTaskDeleted="HandleTaskDeleted" />
                        }
                    </div>
                }
            </div>
        </div>
    }

</div>

@code {
    private List<GtdProject>? projects;
    private List<GtdItem>? allTasks;
    private List<GtdContext>? contexts;
    private bool showForm = false;
    private GtdProject projectModel = new GtdProject { Color = "#4f46e5" };
    private GtdProject? editingProject = null;

    // Sub-view state
    private GtdProject? selectedProject = null;
    private List<GtdItem> projectTasks = new();

    protected override async Task OnInitializedAsync()
    {
        contexts = await ContextService.GetContextsAsync();
        allTasks = (await TaskService.GetItemsAsync()).ToList();
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        projects = await ProjectService.GetProjectsAsync();
    }

    private async Task OpenProjectView(GtdProject project)
    {
        selectedProject = project;
        allTasks = (await TaskService.GetItemsAsync()).ToList();
        projectTasks = allTasks.Where(t => t.ProjectId == project.Id)
                               .OrderBy(t => t.Status == GtdStatus.Done || t.Status == GtdStatus.Abandoned ? 1 : 0)
                               .ThenByDescending(t => t.CreatedAt)
                               .ToList();
    }

    private void CloseProjectView()
    {
        selectedProject = null;
        projectTasks = new();
    }

    private async Task HandleTaskUpdated(GtdItem task)
    {
        await TaskService.UpdateItemAsync(task);
        // Refresh the task list in the sub-view
        allTasks = (await TaskService.GetItemsAsync()).ToList();
        if (selectedProject != null)
            projectTasks = allTasks.Where(t => t.ProjectId == selectedProject.Id)
                                   .OrderBy(t => t.Status == GtdStatus.Done || t.Status == GtdStatus.Abandoned ? 1 : 0)
                                   .ThenByDescending(t => t.CreatedAt)
                                   .ToList();
    }

    private async Task HandleTaskDeleted(Guid id)
    {
        await TaskService.DeleteItemAsync(id);
        allTasks = (await TaskService.GetItemsAsync()).ToList();
        if (selectedProject != null)
            projectTasks = allTasks.Where(t => t.ProjectId == selectedProject.Id)
                                   .OrderBy(t => t.Status == GtdStatus.Done || t.Status == GtdStatus.Abandoned ? 1 : 0)
                                   .ThenByDescending(t => t.CreatedAt)
                                   .ToList();
    }

    private void ShowAddForm()
    {
        editingProject = null;
        projectModel = new GtdProject { Color = "#4f46e5" };
        showForm = true;
    }

    private void HideForm()
    {
        showForm = false;
        editingProject = null;
    }

    private void EditProject(GtdProject project)
    {
        editingProject = project;
        projectModel = new GtdProject
        {
            Id = project.Id,
            Name = project.Name,
            Description = project.Description,
            Color = project.Color,
            Status = project.Status,
            OwnerUsername = project.OwnerUsername
        };
        showForm = true;
    }

    private async Task SaveProject()
    {
        if (string.IsNullOrWhiteSpace(projectModel.Name)) return;

        if (editingProject == null)
        {
            await ProjectService.AddProjectAsync(projectModel);
        }
        else
        {
            await ProjectService.UpdateProjectAsync(projectModel);
        }

        HideForm();
        await LoadProjects();
    }

    private async Task SetProjectStatus(GtdProject project, GtdStatus status)
    {
        project.Status = status;
        await ProjectService.UpdateProjectAsync(project);
        await LoadProjects();
    }

    private async Task DeleteProject(Guid id)
    {
        await ProjectService.DeleteProjectAsync(id);
        await LoadProjects();
    }
}
