@page "/contexts"
@using PersonalGTD.Shared.Models
@using PersonalGTD.Shared.Services
@inject IContextService ContextService
@inject ITaskService TaskService

<PageTitle>Filtres - Mon organiseur</PageTitle>

<div class="page-header">
    <h2 class="page-title">Gestion des Contextes (Filtres @@)</h2>
    <div class="page-actions">
        <button class="btn-primary" @onclick="() => showForm = !showForm">
            @(showForm ? "Fermer" : "Nouveau Contexte")
        </button>
    </div>
</div>

@if (showForm)
{
    <div class="form-card">
        <h3>@(editingId.HasValue ? "Modifier le contexte" : "Nouveau contexte")</h3>
        
        <div class="form-group">
            <label>Nom du contexte (ex: @@Maison, #Urgent)</label>
            <input type="text" @bind="currentContext.Name" placeholder="@@Bureau" />
        </div>
        
        <div class="form-group">
            <label>Couleur du badge</label>
            <input type="color" @bind="currentContext.Color" />
        </div>
        
        <div class="form-actions">
            <button class="btn-secondary" @onclick="CancelEdit">Annuler</button>
            <button class="btn-primary" @onclick="SaveContext">Sauvegarder</button>
        </div>
    </div>
}

<div class="list-container">
    @if (contexts == null)
    {
        <div class="loading-state">
            <div class="skeleton-item" style="height: 40px;"></div>
            <div class="skeleton-item" style="height: 40px;"></div>
            <div class="skeleton-item" style="height: 40px;"></div>
        </div>
    }
    else if (!contexts.Any())
    {
        <div class="empty-state">
            <p>Aucun contexte configuré.</p>
        </div>
    }
    else
    {
            @foreach (var c in contexts)
        {
            <div class="list-item-wrapper">
                <div class="list-item">
                    <div class="context-badge" style="background-color: @(c.Color)20; color: @c.Color; border: 1px solid @c.Color">
                        @c.Name
                    </div>
                    
                    <div class="actions">
                        <button class="icon-btn view-tasks @(expandedContextId == c.Id ? "active" : "")" @onclick="() => ToggleContextTasks(c.Id)" title="Voir les tâches">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        </button>
                        <button class="icon-btn edit" @onclick="() => EditContext(c)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        </button>
                        <button class="icon-btn delete" @onclick="() => DeleteContext(c.Id)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </button>
                    </div>
                </div>

                @if (expandedContextId == c.Id)
                {
                    var contextTasks = GetTasksForContext(c.Id);
                    <div class="tasks-panel">
                        <div class="tasks-panel-header">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                            <span>Tâches liées (@contextTasks.Count)</span>
                        </div>
                        @if (!contextTasks.Any())
                        {
                            <p class="tasks-panel-empty">Aucune tâche liée à ce contexte.</p>
                        }
                        else
                        {
                            <ul class="tasks-panel-list">
                                @foreach (var t in contextTasks)
                                {
                                    <li class="tasks-panel-item @(t.Status == GtdStatus.Done ? "done" : "")">
                                        <span class="task-status-dot status-@t.Status.ToString().ToLower()"></span>
                                        <span class="task-title">@t.Title</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<GtdContext>? contexts;
    private List<GtdItem>? allTasks;
    private bool showForm = false;
    private GtdContext currentContext = new();
    private Guid? editingId = null;
    private Guid? expandedContextId = null;

    protected override async Task OnInitializedAsync()
    {
        allTasks = (await TaskService.GetItemsAsync()).ToList();
        await LoadContexts();
    }

    private async Task LoadContexts()
    {
        contexts = await ContextService.GetContextsAsync();
    }

    private List<GtdItem> GetTasksForContext(Guid contextId)
    {
        if (allTasks == null) return new List<GtdItem>();
        return allTasks.Where(t => t.ContextId == contextId).ToList();
    }

    private async Task ToggleContextTasks(Guid contextId)
    {
        if (expandedContextId == contextId)
        {
            expandedContextId = null;
        }
        else
        {
            allTasks = (await TaskService.GetItemsAsync()).ToList();
            expandedContextId = contextId;
        }
    }

    private void EditContext(GtdContext c)
    {
        currentContext = new GtdContext
        {
            Id = c.Id,
            Name = c.Name,
            Color = c.Color
        };
        editingId = c.Id;
        showForm = true;
    }

    private void CancelEdit()
    {
        currentContext = new();
        editingId = null;
        showForm = false;
    }

    private async Task SaveContext()
    {
        if (string.IsNullOrWhiteSpace(currentContext.Name)) return;

        if (editingId.HasValue)
        {
            await ContextService.UpdateContextAsync(currentContext);
        }
        else
        {
            await ContextService.AddContextAsync(currentContext);
        }

        await LoadContexts();
        CancelEdit();
    }

    private async Task DeleteContext(Guid id)
    {
        await ContextService.DeleteContextAsync(id);
        await LoadContexts();
    }
}
