@page "/contexts"
@using PersonalGTD.Shared.Models
@using PersonalGTD.Shared.Services
@inject IContextService ContextService
@inject ITaskService TaskService
@inject IProjectService ProjectService

<PageTitle>Filtres - Mon organiseur</PageTitle>

<div class="page-container">

    @if (selectedContext == null)
    {
        <!-- ===== VUE LISTE DES CONTEXTES ===== -->
        <div class="page-header">
            <h1 class="page-title">Filtres et Contextes</h1>
            <p class="page-subtitle">Triez vos actions par lieu, outil ou état d'esprit.</p>
            <div class="page-actions">
                <button class="btn-primary" @onclick="ShowAddForm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    Nouveau Filtre
                </button>
            </div>
        </div>

        @if (showForm)
        {
            <div class="form-card">
                <h3>@(editingId.HasValue ? "Modifier le contexte" : "Nouveau contexte")</h3>
                
                <div class="form-group">
                    <label>Nom du contexte (ex: @@Maison, #Urgent)</label>
                    <input type="text" @bind="currentContext.Name" placeholder="@@Bureau" />
                </div>
                
                <div class="form-group">
                    <label>Couleur du badge</label>
                    <input type="color" @bind="currentContext.Color" />
                </div>
                
                <div class="form-actions">
                    <button class="btn-secondary" @onclick="CancelEdit">Annuler</button>
                    <button class="btn-primary" @onclick="SaveContext">Sauvegarder</button>
                </div>
            </div>
        }

        <div class="grid-container">
            @if (contexts == null)
            {
                <div class="loading-state">
                    <p>Chargement...</p>
                </div>
            }
            else if (!contexts.Any())
            {
                <div class="empty-state">
                    <p>Aucun contexte configuré.</p>
                </div>
            }
            else
            {
                @foreach (var c in contexts)
                {
                    <div class="card" style="--accent-color: @c.Color; border-left: 4px solid var(--accent-color);">
                        <div class="card-top">
                            <svg class="card-title-icon" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" style="color: var(--accent-color);">
                                <defs>
                                    <linearGradient id="filtGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="currentColor" stop-opacity="1" />
                                        <stop offset="100%" stop-color="currentColor" stop-opacity="0.3" />
                                    </linearGradient>
                                    <linearGradient id="filtGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
                                        <stop offset="0%" stop-color="currentColor" stop-opacity="0.8" />
                                        <stop offset="100%" stop-color="currentColor" stop-opacity="0.2" />
                                    </linearGradient>
                                </defs>
                                <path d="M4 6h16a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z" fill="url(#filtGrad)" />
                                <path d="M7 13h10a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-1a2 2 0 0 1 2-2z" fill="url(#filtGrad2)" />
                                <path d="M10 19h4a1.5 1.5 0 0 1 1.5 1.5v0a1.5 1.5 0 0 1-1.5 1.5h-4A1.5 1.5 0 0 1 8.5 20.5v0A1.5 1.5 0 0 1 10 19z" fill="url(#filtGrad)" />
                            </svg>
                            <h4 class="project-title">@c.Name</h4>
                        </div>

                        <div class="card-footer">
                            <button class="btn-view-tasks" @onclick="() => OpenContextView(c)" title="Voir les tâches liées">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            </button>
                            <div class="card-actions">
                                <button class="icon-btn edit" @onclick="() => EditContext(c)" title="Modifier">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </button>
                                <button class="icon-btn delete" @onclick="() => DeleteContext(c.Id)" title="Supprimer">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <!-- ===== VUE DÉTAIL CONTEXTE : TÂCHES LIÉES ===== -->
        <div class="project-detail-view">
            <div class="detail-header" style="background: linear-gradient(135deg, @selectedContext.Color 0%, #0f172a 100%);">
                <button class="btn-back" @onclick="CloseContextView">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    Retour aux filtres
                </button>
                <div class="detail-title-block">
                    <h2 class="detail-project-name">@selectedContext.Name</h2>
                </div>
            </div>

            <div class="detail-tasks-section">
                <div class="detail-tasks-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" style="color: var(--accent-color);">
                        <path opacity="0.25" d="M3 4C3 3.44772 3.44772 3 4 3H20C20.5523 3 21 3.44772 21 4V6.58579C21 6.851 20.8946 7.10536 20.7071 7.29289L14 14V22L10 18V14L3.29289 7.29289C3.10536 7.10536 3 6.851 3 6.58579V4Z" fill="currentColor"/>
                        <path d="M3 4C3 3.44772 3.44772 3 4 3H20C20.5523 3 21 3.44772 21 4V6.58579C21 6.851 20.8946 7.10536 20.7071 7.29289L14 14V22L10 18V14L3.29289 7.29289C3.10536 7.10536 3 6.851 3 6.58579V4Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>Actions filtrées <span class="task-count-badge">@contextTasks.Count</span></span>
                </div>

                @if (!contextTasks.Any())
                {
                    <div class="detail-empty">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                        <p>Aucune tâche associée à ce filtre.</p>
                    </div>
                }
                else
                {
                    <div class="task-list">
                        @foreach (var task in contextTasks)
                        {
                            <TaskItemCard Task="task"
                                         Projects="projects"
                                         Contexts="contexts"
                                         OnTaskUpdated="HandleTaskUpdated"
                                         OnTaskDeleted="HandleTaskDeleted" />
                        }
                    </div>
                }
            </div>
        </div>
    }

</div>

@code {
    private List<GtdContext>? contexts;
    private List<GtdProject>? projects;
    private List<GtdItem>? allTasks;
    private bool showForm = false;
    private GtdContext currentContext = new();
    private Guid? editingId = null;

    // Sub-view state
    private GtdContext? selectedContext = null;
    private List<GtdItem> contextTasks = new();

    protected override async Task OnInitializedAsync()
    {
        projects = await ProjectService.GetProjectsAsync();
        allTasks = (await TaskService.GetItemsAsync()).ToList();
        await LoadContexts();
    }

    private async Task LoadContexts()
    {
        contexts = await ContextService.GetContextsAsync();
    }

    private async Task OpenContextView(GtdContext context)
    {
        selectedContext = context;
        allTasks = (await TaskService.GetItemsAsync()).ToList();
        contextTasks = allTasks.Where(t => t.ContextId == context.Id)
                               .OrderBy(t => t.Status == GtdStatus.Done || t.Status == GtdStatus.Abandoned ? 1 : 0)
                               .ThenByDescending(t => t.CreatedAt)
                               .ToList();
    }

    private void CloseContextView()
    {
        selectedContext = null;
        contextTasks = new();
    }

    private async Task HandleTaskUpdated(GtdItem task)
    {
        await TaskService.UpdateItemAsync(task);
        allTasks = (await TaskService.GetItemsAsync()).ToList();
        if (selectedContext != null)
            contextTasks = allTasks.Where(t => t.ContextId == selectedContext.Id)
                                   .OrderBy(t => t.Status == GtdStatus.Done || t.Status == GtdStatus.Abandoned ? 1 : 0)
                                   .ThenByDescending(t => t.CreatedAt)
                                   .ToList();
    }

    private async Task HandleTaskDeleted(Guid id)
    {
        await TaskService.DeleteItemAsync(id);
        allTasks = (await TaskService.GetItemsAsync()).ToList();
        if (selectedContext != null)
            contextTasks = allTasks.Where(t => t.ContextId == selectedContext.Id)
                                   .OrderBy(t => t.Status == GtdStatus.Done || t.Status == GtdStatus.Abandoned ? 1 : 0)
                                   .ThenByDescending(t => t.CreatedAt)
                                   .ToList();
    }

    private void ShowAddForm()
    {
        editingId = null;
        currentContext = new GtdContext { Color = "#4f46e5" };
        showForm = true;
    }

    private void CancelEdit()
    {
        currentContext = new();
        editingId = null;
        showForm = false;
    }

    private void EditContext(GtdContext c)
    {
        currentContext = new GtdContext
        {
            Id = c.Id,
            Name = c.Name,
            Color = c.Color
        };
        editingId = c.Id;
        showForm = true;
    }

    private async Task SaveContext()
    {
        if (string.IsNullOrWhiteSpace(currentContext.Name)) return;

        if (editingId.HasValue)
        {
            await ContextService.UpdateContextAsync(currentContext);
        }
        else
        {
            await ContextService.AddContextAsync(currentContext);
        }

        await LoadContexts();
        CancelEdit();
    }

    private async Task DeleteContext(Guid id)
    {
        await ContextService.DeleteContextAsync(id);
        await LoadContexts();
    }
}
