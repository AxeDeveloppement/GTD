@page "/agenda"
@using PersonalGTD.Shared.Models
@using PersonalGTD.Shared.Services
@inject ITaskService TaskService
@inject IProjectService ProjectService
@inject IContextService ContextService

<PageTitle>Agenda - Mon organiseur</PageTitle>

<div class="gtd-container">
    <div class="page-header">
        <h2 class="page-title">Agenda</h2>
        <p class="page-subtitle">Gérez vos tâches planifiées à une date précise.</p>
    </div>

    <div class="tabs-container">
        <div class="tabs-wrapper">
            <button class="tab-button @(activeTab == AgendaTab.Calendar ? "active" : "")" @onclick="() => SetActiveTab(AgendaTab.Calendar)">
                Calendrier
            </button>
            <button class="tab-button @(activeTab == AgendaTab.Overdue ? "active" : "")" @onclick="() => SetActiveTab(AgendaTab.Overdue)">
                En retard
                @if (overdueCount > 0) { <span class="count-badge red">@overdueCount</span> }
            </button>
        </div>
        <div class="tabs-wrapper">
            <button class="tab-button @(activeTab == AgendaTab.Today ? "active" : "")" @onclick="() => SetActiveTab(AgendaTab.Today)">
                Aujourd'hui
                @if (todayCount > 0) { <span class="count-badge orange">@todayCount</span> }
            </button>
            <button class="tab-button @(activeTab == AgendaTab.Upcoming ? "active" : "")" @onclick="() => SetActiveTab(AgendaTab.Upcoming)">
                À venir
            </button>
        </div>
    </div>

    @if (activeTab == AgendaTab.Calendar)
    {
        <div class="calendar-controls">
            <button class="cal-btn" @onclick="PreviousMonth">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <h3 class="cal-month">@currentDate.ToString("MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</h3>
            <button class="cal-btn" @onclick="NextMonth">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
        </div>

        <div class="calendar-grid">
            <div class="day-header">Lun</div>
            <div class="day-header">Mar</div>
            <div class="day-header">Mer</div>
            <div class="day-header">Jeu</div>
            <div class="day-header">Ven</div>
            <div class="day-header">Sam</div>
            <div class="day-header">Dim</div>

            @foreach (var day in GetCalendarDays())
            {
                <div class="calendar-day @(day.Date == DateTime.Now.Date ? "today" : "") @(day.Month != currentDate.Month ? "other-month" : "")">
                    <span class="day-number">@day.Day</span>
                    <div class="day-tasks">
                        @foreach(var t in GetTasksForDate(day.Date))
                        {
                            <div class="cal-task @GetTaskColorClass(t)" title="@t.Title" @onclick="() => NavigateToTask(t)">
                                @t.Title
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="task-list">
            @if (tasks == null)
            {
                <div class="loading-state">Chargement...</div>
            }
            else if (!tasks.Any())
            {
                <div class="empty-state">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <p>Aucune tâche planifiée dans cette section.</p>
                </div>
            }
            else
            {
                @foreach (var task in tasks)
                {
                    <TaskItemCard Task="task" Projects="projects" Contexts="contexts" OnTaskUpdated="HandleTaskUpdated" OnTaskDeleted="DeleteItemAsync" IsHighlighted="@(task.Id == highlightedTaskId)" />
                }
            }
        </div>
    }
</div>

@code {
    private IEnumerable<GtdItem>? allAgendaTasks;
    private IEnumerable<GtdItem>? tasks;
    private List<GtdProject>? projects;
    private List<GtdContext>? contexts;

    private int overdueCount = 0;
    private int todayCount = 0;

    private DateTime currentDate = DateTime.Now;

    private AgendaTab activeTab = AgendaTab.Calendar;
    private Guid? highlightedTaskId = null;

    private enum AgendaTab { Calendar, Overdue, Today, Upcoming }

    protected override async Task OnInitializedAsync()
    {
        projects = await ProjectService.GetProjectsAsync();
        contexts = await ContextService.GetContextsAsync();
        await LoadTasksAsync();
    }

    private async Task LoadTasksAsync()
    {
        var all = await TaskService.GetItemsAsync();
        // Only active tasks with a DueDate
        allAgendaTasks = all.Where(t => t.Status != GtdStatus.Done && t.Status != GtdStatus.Abandoned && t.DueDate.HasValue);
        
        var today = DateTime.Now.Date;
        overdueCount = allAgendaTasks.Count(t => t.DueDate!.Value.Date < today);
        todayCount = allAgendaTasks.Count(t => t.DueDate!.Value.Date == today);

        FilterTasks();
    }

    private void SetActiveTab(AgendaTab tab)
    {
        activeTab = tab;
        highlightedTaskId = null;
        FilterTasks();
    }

    private void FilterTasks()
    {
        if (allAgendaTasks == null) return;
        
        var today = DateTime.Now.Date;

        if (activeTab == AgendaTab.Overdue)
            tasks = allAgendaTasks.Where(t => t.DueDate!.Value.Date < today).OrderBy(t => t.DueDate);
        else if (activeTab == AgendaTab.Today)
            tasks = allAgendaTasks.Where(t => t.DueDate!.Value.Date == today);
        else if (activeTab == AgendaTab.Upcoming)
            tasks = allAgendaTasks.Where(t => t.DueDate!.Value.Date > today).OrderBy(t => t.DueDate);
    }

    private async Task HandleTaskUpdated(GtdItem task)
    {
        await TaskService.UpdateItemAsync(task);
        await LoadTasksAsync();
    }

    private async Task DeleteItemAsync(Guid id)
    {
        await TaskService.DeleteItemAsync(id);
        await LoadTasksAsync();
    }

    // --- Calendar Logic ---

    private void PreviousMonth() => currentDate = currentDate.AddMonths(-1);
    private void NextMonth() => currentDate = currentDate.AddMonths(1);

    private List<DateTime> GetCalendarDays()
    {
        var days = new List<DateTime>();
        var firstDayOfMonth = new DateTime(currentDate.Year, currentDate.Month, 1);
        
        // Start week on Monday
        int offset = (int)firstDayOfMonth.DayOfWeek - (int)DayOfWeek.Monday;
        if (offset < 0) offset += 7;

        var currentDay = firstDayOfMonth.AddDays(-offset);
        
        // 42 days grid (6 weeks)
        for (int i = 0; i < 42; i++)
        {
            days.Add(currentDay);
            currentDay = currentDay.AddDays(1);
        }

        return days;
    }

    private IEnumerable<GtdItem> GetTasksForDate(DateTime date)
    {
        if (allAgendaTasks == null) return Enumerable.Empty<GtdItem>();
        return allAgendaTasks.Where(t => t.DueDate!.Value.Date == date.Date);
    }

    private string GetTaskColorClass(GtdItem task)
    {
        if (!task.DueDate.HasValue) return "";
        var date = task.DueDate.Value.Date;
        var today = DateTime.Now.Date;

        if (date < today) return "cal-red";
        if (date == today) return "cal-orange";
        return "cal-green";
    }

    private void NavigateToTask(GtdItem task)
    {
        if (!task.DueDate.HasValue) return;
        var date = task.DueDate.Value.Date;
        var today = DateTime.Now.Date;

        if (date < today)
            activeTab = AgendaTab.Overdue;
        else if (date == today)
            activeTab = AgendaTab.Today;
        else
            activeTab = AgendaTab.Upcoming;

        highlightedTaskId = task.Id;
        FilterTasks();
    }
}
