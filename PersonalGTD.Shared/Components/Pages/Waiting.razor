@page "/waiting"
@using PersonalGTD.Shared.Models
@using PersonalGTD.Shared.Services
@inject ITaskService TaskService
@inject IProjectService ProjectService
@inject IContextService ContextService

<PageTitle>En attente - Mon organiseur</PageTitle>

<div class="gtd-container">
    <div class="page-header">
        <h2 class="page-title">En attente</h2>
        <p class="page-subtitle">Les tâches bloquées par un événement externe ou déléguées.</p>
    </div>

    <div class="task-list">
        @if (tasks == null)
        {
            <div class="loading-state">
                <div class="skeleton-item"></div>
                <div class="skeleton-item"></div>
                <div class="skeleton-item"></div>
            </div>
        }
        else if (!tasks.Any())
        {
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                <p>Aucune tâche en attente.</p>
            </div>
        }
        else
        {
            @foreach (var task in tasks)
            {
                <TaskItemCard Task="task" Projects="projects" Contexts="contexts" OnTaskUpdated="HandleTaskUpdated" OnTaskDeleted="DeleteItemAsync" />
            }
        }
    </div>
</div>

@code {
    private IEnumerable<GtdItem>? tasks;
    private List<GtdProject>? projects;
    private List<GtdContext>? contexts;

    protected override async Task OnInitializedAsync()
    {
        projects = await ProjectService.GetProjectsAsync();
        contexts = await ContextService.GetContextsAsync();
        await LoadTasksAsync();
    }

    private async Task LoadTasksAsync()
    {
        var allTasks = await TaskService.GetItemsAsync();
        tasks = allTasks.Where(t => t.Status == GtdStatus.Waiting);
    }

    private async Task HandleTaskUpdated(GtdItem task)
    {
        await TaskService.UpdateItemAsync(task);
        await LoadTasksAsync();
    }

    private async Task DeleteItemAsync(Guid id)
    {
        await TaskService.DeleteItemAsync(id);
        await LoadTasksAsync();
    }
}
