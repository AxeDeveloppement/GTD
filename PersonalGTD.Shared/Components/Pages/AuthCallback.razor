@page "/auth/callback"
@using PersonalGTD.Shared.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<div class="callback-page">
    <div class="callback-card">
        <div class="loading-spinner"></div>
        <h2 class="callback-title">Connexion...</h2>
        <p class="callback-text">Nous finalisons votre connexion. Veuillez patienter un instant.</p>
    </div>
</div>

<style>
    .callback-page {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background-color: #0f172a;
        color: #f8fafc;
        font-family: 'Outfit', sans-serif;
    }

    .callback-card {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 3rem;
        border-radius: 24px;
        text-align: center;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        max-width: 400px;
        width: 90%;
    }

    .callback-title {
        margin-top: 1.5rem;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    .callback-text {
        margin-top: 0.5rem;
        opacity: 0.7;
        line-height: 1.6;
    }

    .loading-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid rgba(255, 255, 255, 0.1);
        border-left-color: #3b82f6;
        border-radius: 50%;
        margin: 0 auto;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Give the Supabase client a moment to parse the URL fragment/query
        await Task.Delay(1000); 
        
        var success = await AuthService.HandleCallbackAsync();
        if (success)
        {
            NavigationManager.NavigateTo("", forceLoad: true);
        }
        else
        {
            // If it failed, maybe it's still processing or there was an error
            // We'll try one more time after another short delay
            await Task.Delay(1000);
            success = await AuthService.HandleCallbackAsync();
            
            if (success)
            {
                NavigationManager.NavigateTo("", forceLoad: true);
            }
            else
            {
                NavigationManager.NavigateTo("?error=auth_failed");
            }
        }
    }
}
