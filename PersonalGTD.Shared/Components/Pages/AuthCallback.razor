@page "/auth/callback"
@using PersonalGTD.Shared.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div style="display:flex; flex-direction:column; justify-content:center; align-items:center; height:100vh; background-color: #0f172a; color: #f8fafc; gap: 1.5rem;">
    <div class="loading-spinner"></div>
    <p style="font-family: 'Outfit', sans-serif; font-size: 1.1rem; letter-spacing: 0.05em; opacity: 0.8;">Finalisation de la connexion...</p>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Capturer le fragment d'URL manuellement via JS avant que Blazor ne s'en mêle trop
            var hash = await JS.InvokeAsync<string>("eval", "window.location.hash");
            
            if (!string.IsNullOrEmpty(hash) && hash.Contains("access_token="))
            {
                // Sauvegarder temporairement pour aider AuthService
                await JS.InvokeVoidAsync("localStorage.setItem", "supabase_auth_token", hash);
            }

            // Attendre un peu pour laisser le SDK Supabase traiter le fragment (il le voit aussi via l'URL)
            await Task.Delay(1000);

            // Tenter de récupérer l'utilisateur
            await AuthService.InitializeAsync();

            if (AuthService.CurrentUser != null)
            {
                // Succès ! Direction la Inbox
                NavigationManager.NavigateTo(NavigationManager.BaseUri);
            }
            else
            {
                // Échec ? On retourne au login
                NavigationManager.NavigateTo(NavigationManager.BaseUri);
            }
        }
        catch
        {
            NavigationManager.NavigateTo(NavigationManager.BaseUri);
        }
    }
}
