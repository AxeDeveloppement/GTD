@page "/"
@using PersonalGTD.Shared.Models
@using PersonalGTD.Shared.Services
@inject ITaskService TaskService

@inject IProjectService ProjectService
@inject IContextService ContextService

<PageTitle>PersonalGTD - Tasks</PageTitle>

<div class="gtd-container">
    <div class="add-task-card">
        <input type="text" class="task-input" placeholder="What needs to be done?" @bind="newTaskTitle" @bind:event="oninput" @onkeyup="HandleKeyUp" />
        
        <div class="selectors">
            <select class="context-select" @bind="newContextId">
                <option value="@Guid.Empty">-- Aucun contexte --</option>
                @if (contexts != null)
                {
                    @foreach (var c in contexts)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                }
            </select>

            <select class="project-select" @bind="newProjectId">
                <option value="@Guid.Empty">-- Aucun projet --</option>
                @if (projects != null)
                {
                    @foreach (var p in projects)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                }
            </select>
        </div>

        <button class="add-button" @onclick="AddTaskAsync" disabled="@string.IsNullOrWhiteSpace(newTaskTitle)">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </button>
    </div>

    <div class="task-list">
        @if (tasks == null)
        {
            <div class="loading-state">Loading tasks...</div>
        }
        else if (!tasks.Any())
        {
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <p>All caught up! You have no pending tasks.</p>
            </div>
        }
        else
        {
            @foreach (var task in tasks)
            {
                <div class="task-card @(task.Status == GtdStatus.Archived ? "completed" : "")">
                    <div class="checkbox-wrapper">
                        <input type="checkbox" id="@task.Id" checked="@(task.Status == GtdStatus.Archived)" @onchange="@(e => ToggleCompletionAsync(task, e))" />
                        <label for="@task.Id"></label>
                    </div>
                    <div class="task-content">
                        <div class="task-title">@task.Title</div>
                        <div class="task-badges">
                            @if (task.ProjectId.HasValue && projects != null)
                            {
                                var proj = projects.FirstOrDefault(p => p.Id == task.ProjectId);
                                if (proj != null)
                                {
                                    <span class="task-project" style="color: @proj.Color; background-color: @(proj.Color)20; border: 1px solid @proj.Color">@proj.Name</span>
                                }
                            }
                            @if (task.ContextId.HasValue && contexts != null)
                            {
                                var ctx = contexts.FirstOrDefault(c => c.Id == task.ContextId);
                                if (ctx != null)
                                {
                                    <span class="task-context" style="color: @ctx.Color; background-color: @(ctx.Color)20; border: 1px solid @ctx.Color">@ctx.Name</span>
                                }
                            }
                        </div>
                    </div>
                    <button class="delete-button" @onclick="@(() => DeleteItemAsync(task.Id))">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                    </button>
                </div>
            }
        }
    </div>
</div>

@code {
    private IEnumerable<GtdItem>? tasks;
    private List<GtdProject>? projects;
    private List<GtdContext>? contexts;
    
    private string newTaskTitle = string.Empty;
    private Guid newProjectId = Guid.Empty;
    private Guid newContextId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        projects = await ProjectService.GetProjectsAsync();
        contexts = await ContextService.GetContextsAsync();
        await LoadTasksAsync();
    }

    private async Task LoadTasksAsync()
    {
        tasks = await TaskService.GetItemsAsync();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newTaskTitle))
        {
            await AddTaskAsync();
        }
    }

    private async Task AddTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(newTaskTitle)) return;

        var task = new GtdItem
        {
            Title = newTaskTitle,
            ProjectId = newProjectId == Guid.Empty ? null : newProjectId,
            ContextId = newContextId == Guid.Empty ? null : newContextId
        };

        await TaskService.AddItemAsync(task);
        newTaskTitle = string.Empty;
        newProjectId = Guid.Empty;
        newContextId = Guid.Empty;
        await LoadTasksAsync();
    }

    private async Task ToggleCompletionAsync(GtdItem task, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        task.Status = isChecked ? GtdStatus.Archived : GtdStatus.Inbox;
        await TaskService.UpdateItemAsync(task);
        await LoadTasksAsync();
    }

    private async Task DeleteItemAsync(Guid id)
    {
        await TaskService.DeleteItemAsync(id);
        await LoadTasksAsync();
    }
}
