@inherits LayoutComponentBase
@implements IDisposable
@inject PersonalGTD.Shared.Services.AuthService AuthService
@inject PersonalGTD.Shared.Services.ReviewStateService ReviewState
@inject IJSRuntime JS
@inject PersonalGTD.Shared.Services.NotificationService NotificationService
@inject NavigationManager NavigationManager

<AuthListener />

@if (!isReady)
{
    <div style="display:flex; flex-direction:column; justify-content:center; align-items:center; height:100vh; background-color: #0f172a; color: #f8fafc; gap: 1.5rem;">
        <div class="loading-spinner"></div>
        <p style="font-family: 'Outfit', sans-serif; font-size: 1.1rem; letter-spacing: 0.05em; opacity: 0.8;">Initialisation...</p>
    </div>
}
else if (AuthService.CurrentUser == null)
{
    <div class="login-page">
        <div class="login-card">

            <!-- Logo / Titre -->
            <div class="login-brand">
                <div class="login-logo">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                </div>
                <h1 class="login-title">Mon organiseur</h1>
                <p class="login-subtitle">Gérez vos tâches avec la méthode GTD</p>
            </div>

            <!-- Connexion simplifiée -->
            <div class="login-form" style="display: flex; flex-direction: column; align-items: center; gap: 2rem; padding: 1rem 0;">
                <p style="text-align: center; color: #e2e8f0; font-size: 1.1rem; line-height: 1.6; margin: 0; font-weight: 500;">
                    Essayer sans compte avec votre compte Google
                </p>
                
                <GoogleLoginButton />
                
                <p style="text-align: center; color: #94a3b8; font-size: 0.85rem; opacity: 0.8; margin: 0;">
                    Accès instantané à votre espace personnel
                </p>
            </div>

        </div>
    </div>
}
else
{
    <div class="app-container">
        <Sidebar @bind-IsOpen="isSidebarOpen" />
        
        <div class="main-wrapper">
            <header class="app-header">
                <button class="menu-btn d-mobile" @onclick="() => isSidebarOpen = true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <h1 class="app-title">Mon organiseur<span class="d-desktop"> (@AuthService.CurrentUser)</span></h1>
                
                <button class="logout-btn" @onclick="LogoutAsync" title="Déconnexion">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    <span class="logout-text">Déconnexion</span>
                </button>
            </header>
            <main class="app-main">
                @Body
            </main>
        </div>

        <FabCapture />
    </div>
}

@code {
    private bool isReady;
    private bool isSidebarOpen;

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnAuthStateChanged += HandleAuthStateChanged;
        
        // Détecter la session dès le chargement, particulièrement utile pour le retour d'OAuth
        if (AuthService.CurrentUser == null)
        {
            await AuthService.InitializeAsync();
        }
    }

    private void HandleAuthStateChanged()
    {
        _ = CheckAuthRedirect();
        StateHasChanged();
    }

    private async Task CheckAuthRedirect()
    {
        var uri = NavigationManager.Uri;
        if (AuthService.CurrentUser != null && (uri.Contains("#access_token") || uri.Contains("access_token=")))
        {
            // Nettoyer l'URL via JS sans recharger la page pour ne pas perdre l'état
            await JS.InvokeVoidAsync("window.history.replaceState", null, "", NavigationManager.BaseUri);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= HandleAuthStateChanged;
    }



    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        ReviewState.ResetReview();
    }

    private async Task LoadReviewStateAsync()
    {
        var user = AuthService.CurrentUser ?? "unknown";
        var doneAt = await JS.InvokeAsync<string?>("localStorage.getItem", $"gtd-review-done-at-{user}");
        if (!string.IsNullOrEmpty(doneAt) && DateTime.TryParse(doneAt, out var dt))
        {
            if (dt >= ReviewStateService.GetLastReviewTrigger())
            {
                ReviewState.MarkReviewDone();
                return;
            }
        }
        ReviewState.ResetReview();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                await JS.InvokeVoidAsync("window.notificationHelper.registerNavigationHandler", DotNetObjectReference.Create(this));
                
                var uri = NavigationManager.Uri;
                if (uri.Contains("#access_token") || uri.Contains("access_token=") || uri.Contains("auth/callback"))
                {
                    // Nettoyer l'URL sans recharger pour une expérience fluide
                    await JS.InvokeVoidAsync("window.history.replaceState", null, "", NavigationManager.BaseUri);
                    
                    // Si on vient de se connecter mais que l'UI n'a pas suivi, forcer un rafraîchissement
                    if (AuthService.CurrentUser == null)
                    {
                        await AuthService.InitializeAsync();
                    }
                }
                
                if (AuthService.CurrentUser != null)
                {
                    await LoadReviewStateAsync();
                    await NotificationService.RequestPermissionAsync();
                    await NotificationService.CheckAndNotifyAsync();
                }
            }
            catch { /* WebView not ready or not supported */ }
            finally
            {
                isReady = true;
                StateHasChanged();
            }
        }
    }

    [JSInvokable]
    public void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url.TrimStart('/'));
    }
}
