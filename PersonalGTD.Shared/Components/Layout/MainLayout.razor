@inherits LayoutComponentBase
@implements IDisposable
@inject PersonalGTD.Shared.Services.AuthService AuthService
@inject PersonalGTD.Shared.Services.ReviewStateService ReviewState
@inject IJSRuntime JS
@inject PersonalGTD.Shared.Services.NotificationService NotificationService
@inject NavigationManager NavigationManager

<AuthListener />

@if (!isReady)
{
    <div style="display:flex; flex-direction:column; justify-content:center; align-items:center; height:100vh; background-color: #0f172a; color: #f8fafc; gap: 1.5rem;">
        <div class="loading-spinner"></div>
        <p style="font-family: 'Outfit', sans-serif; font-size: 1.1rem; letter-spacing: 0.05em; opacity: 0.8;">Initialisation...</p>
    </div>
}
else if (AuthService.CurrentUser == null)
{
    <div class="login-page">
        <div class="login-card">

            <!-- Logo / Titre -->
            <div class="login-brand">
                <div class="login-logo">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                </div>
                <h1 class="login-title">Mon organiseur</h1>
                <p class="login-subtitle">Gérez vos tâches avec la méthode GTD</p>
            </div>

            <!-- Formulaire -->
            <div class="login-form">
                <div class="login-field">
                    <label class="login-label">Identifiant</label>
                    <input @bind="loginUsername" type="text" class="login-input" placeholder="Votre nom d'utilisateur" />
                </div>

                <div class="login-field">
                    <label class="login-label">Mot de passe</label>
                    <input @bind="loginPassword" type="password" class="login-input" placeholder="••••••••" @onkeyup="HandleLoginKeyUp" />
                </div>

                @if (loginError)
                {
                    <div class="login-error">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <span>Identifiants incorrects. Veuillez réessayer.</span>
                    </div>
                }

                <button @onclick="LoginAsync" class="login-btn">
                    Se connecter
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </button>

                <div class="login-divider">OU</div>

                <GoogleLoginButton />
            </div>

            <!-- Encart démo -->
            <button class="demo-card" @onclick="FillDemo" title="Cliquer pour pré-remplir les champs">
                <div class="demo-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                </div>
                <div class="demo-text">
                    <span class="demo-label">Essayer sans compte</span>
                    <span class="demo-creds">Identifiant&nbsp;<strong>demo</strong> · Mot de passe&nbsp;<strong>demo</strong></span>
                </div>
                <div class="demo-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </div>
            </button>

        </div>
    </div>
}
else
{
    <div class="app-container">
        <Sidebar @bind-IsOpen="isSidebarOpen" />
        
        <div class="main-wrapper">
            <header class="app-header">
                <button class="menu-btn d-mobile" @onclick="() => isSidebarOpen = true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <h1 class="app-title">Mon organiseur<span class="d-desktop"> (@AuthService.CurrentUser)</span></h1>
                
                <button class="logout-btn" @onclick="LogoutAsync" title="Déconnexion">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    <span class="logout-text">Déconnexion</span>
                </button>
            </header>
            <main class="app-main">
                @Body
            </main>
        </div>

        <FabCapture />
    </div>
}

@code {
    private bool isReady;
    private bool isSidebarOpen;
    private string loginUsername = "";
    private string loginPassword = "";
    private bool loginError = false;

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }

    private async Task LoginAsync()
    {
        loginError = false;
        var success = await AuthService.LoginAsync(loginUsername, loginPassword);
        if (!success)
        {
            loginError = true;
        }
        else
        {
            try
            {
                await LoadReviewStateAsync();
                await NotificationService.RequestPermissionAsync();
                await NotificationService.CheckAndNotifyAsync();
            }
            catch { /* Fail silently */ }
        }
    }

    private void FillDemo()
    {
        loginUsername = "demo";
        loginPassword = "demo";
        loginError = false;
    }

    private async Task HandleLoginKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoginAsync();
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        ReviewState.ResetReview();
        loginUsername = "";
        loginPassword = "";
    }

    private async Task LoadReviewStateAsync()
    {
        var user = AuthService.CurrentUser ?? "unknown";
        var doneAt = await JS.InvokeAsync<string?>("localStorage.getItem", $"gtd-review-done-at-{user}");
        if (!string.IsNullOrEmpty(doneAt) && DateTime.TryParse(doneAt, out var dt))
        {
            if (dt >= ReviewStateService.GetLastReviewTrigger())
            {
                ReviewState.MarkReviewDone();
                return;
            }
        }
        ReviewState.ResetReview();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                // Guarantee AuthService initialization first
                await AuthService.InitializeAsync();
                
                await JS.InvokeVoidAsync("window.notificationHelper.registerNavigationHandler", DotNetObjectReference.Create(this));
                
                if (AuthService.CurrentUser != null)
                {
                    await LoadReviewStateAsync();
                    await NotificationService.RequestPermissionAsync();
                    await NotificationService.CheckAndNotifyAsync();
                }
            }
            catch { /* WebView not ready or not supported */ }
            finally
            {
                isReady = true;
                StateHasChanged();
            }
        }
    }

    [JSInvokable]
    public void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url.TrimStart('/'));
    }
}
