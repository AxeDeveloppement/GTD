@if (IsOpen)
{
    <div class="sidebar-overlay d-mobile" @onclick="ToggleSidebar"></div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private bool isReviewDue = false;
    private System.Timers.Timer? timer;

    protected override void OnInitialized()
    {
        CheckReviewTime(null, null);
        timer = new System.Timers.Timer(60000);
        timer.Elapsed += CheckReviewTime;
        timer.Start();
        ReviewState.OnStateChanged += OnReviewStateChanged;
    }

    private void OnReviewStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private bool ShowReviewAlert => isReviewDue && !ReviewState.IsReviewDoneThisWeek;

    private void CheckReviewTime(object? sender, System.Timers.ElapsedEventArgs? e)
    {
        var now = DateTime.Now;
        bool due = (now.DayOfWeek == DayOfWeek.Friday && now.Hour >= 16) ||
                   now.DayOfWeek == DayOfWeek.Saturday ||
                   now.DayOfWeek == DayOfWeek.Sunday;

        isReviewDue = due;
        ReviewState.Tick();
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSidebar()
    {
        IsOpen = !IsOpen;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    public void Dispose()
    {
        timer?.Dispose();
        ReviewState.OnStateChanged -= OnReviewStateChanged;
    }
}
