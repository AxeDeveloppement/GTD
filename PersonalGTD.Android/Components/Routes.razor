@inject PersonalGTD.Shared.Services.AuthService AuthService
@inject NavigationManager NavigationManager

<Router AppAssembly="@typeof(Routes).Assembly" AdditionalAssemblies="new[] { typeof(PersonalGTD.Shared.Components.Layout.MainLayout).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(PersonalGTD.Shared.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(PersonalGTD.Shared.Components.Layout.MainLayout)">
            <div style="padding:2rem; text-align:center; color:white;">
                <h2 style="font-family:'Outfit', sans-serif;">Page non trouvée</h2>
                <p style="opacity:0.8;">Désolé, il n'y a rien à cette adresse.</p>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private int _authInitStarted = 0;

    protected override void OnInitialized()
    {
        // Navigation explicite vers la page d'accueil pour garantir que le Router
        // trouve une route même si l'URL initiale est vide ou invalide sur Android.
        var currentUri = NavigationManager.Uri;
        var baseUri = NavigationManager.BaseUri.TrimEnd('/');
        if (currentUri == baseUri || currentUri == baseUri + "/" || currentUri.Contains("auth/callback"))
        {
            NavigationManager.NavigateTo("/", forceLoad: false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Interlocked.Exchange(ref _authInitStarted, 1) == 0)
        {
            // Initialiser l'authentification en arrière-plan APRÈS le premier rendu.
            // Utilise Interlocked pour garantir qu'une seule instance lance InitializeAsync.
            // Cela garantit que l'UI est affichée immédiatement, même si Supabase
            // met du temps à répondre ou échoue complètement.
            _ = Task.Run(async () =>
            {
                try
                {
                    await AuthService.InitializeAsync();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Routes] Auth init error (non-fatal): {ex.Message}");
                }
            });
        }
    }
}
