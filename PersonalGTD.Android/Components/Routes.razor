@inject PersonalGTD.Shared.Services.AuthService AuthService

<Router AppAssembly="@typeof(Routes).Assembly" AdditionalAssemblies="new[] { typeof(PersonalGTD.Shared.Components.Layout.MainLayout).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(PersonalGTD.Shared.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(PersonalGTD.Shared.Components.Layout.MainLayout)">
            <div style="padding:2rem; text-align:center; color:white;">
                <h2 style="font-family:'Outfit', sans-serif;">Page non trouvée</h2>
                <p style="opacity:0.8;">Désolé, il n'y a rien à cette adresse.</p>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    protected override void OnInitialized()
    {
        // Ne JAMAIS bloquer OnInitializedAsync avec l'initialisation Supabase.
        // Sur Android, _supabase.InitializeAsync() peut se bloquer indéfiniment
        // (timeout réseau, DNS, etc.) et empêcher le premier rendu Blazor,
        // laissant l'app figée sur "Chargement en cours..." de index.html.
        // L'initialisation est déportée dans OnAfterRenderAsync en fire-and-forget.
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialiser l'authentification en arrière-plan APRÈS le premier rendu.
            // Cela garantit que l'UI est affichée immédiatement, même si Supabase
            // met du temps à répondre ou échoue complètement.
            _ = Task.Run(async () =>
            {
                try
                {
                    await AuthService.InitializeAsync();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Routes] Auth init error (non-fatal): {ex.Message}");
                }
            });
        }
    }
}
